+    def get_absolute_params_and_ci(self):
+        results = []
+        cov = self.model.cov_params()
+        params = self.model.params
+        
+        # Intercept (baseline value)
+        intercept = params.get('const', 0.0)
+        var_intercept = cov.loc['const', 'const'] if 'const' in cov else 0.0
+
+        for feature in self.feature_names:
+            baseline = self.baselines[feature]
+            for value in self.all_levels[feature]:
+                if value == baseline:
+                    # Baseline: value is intercept
+                    se = np.sqrt(var_intercept)
+                    results.append({
+                        "param": feature,
+                        "value": value,
+                        "coef": intercept,
+                        "ci_low": intercept - 1.96 * se,
+                        "ci_high": intercept + 1.96 * se,
+                        "baseline": True
+                    })
+                else:
+                    # Non-baseline: value is intercept + coef
+                    key = f"{feature}=={value}"
+                    coef_diff = params.get(key, 0.0)
+                    abs_coef = intercept + coef_diff
+                    
+                    # Variance of sum: Var(const) + Var(beta) + 2*Cov(const, beta)
+                    var_diff = cov.loc[key, key] if key in cov else 0.0
+                    cov_int_diff = cov.loc['const', key] if ('const' in cov and key in cov) else 0.0
+                    
+                    var_abs = var_intercept + var_diff + 2 * cov_int_diff
+                    se = np.sqrt(var_abs) if var_abs > 0 else 0.0
+
+                    results.append({
+                        "param": feature,
+                        "value": value,
+                        "coef": abs_coef,
+                        "ci_low": abs_coef - 1.96 * se,
+                        "ci_high": abs_coef + 1.96 * se,
+                        "baseline": False
+                    })
+        return pd.DataFrame(results)
+
 
